# Copy this file to "keystore.properties" (same folder) and fill in your real values.
# keystore.properties is gitignored — never commit it or your passwords.
#
# Use forward slashes in the path even on Windows.
# This points at the shared keystore created in Step 2 (keytool ... -keystore vaygo-release.keystore).
storeFile=D:/VAYGO/vaygo-release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=vaygo
keyPassword=YOUR_KEY_PASSWORD
